{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "somos-verbo",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // Cada versión subida desde una rama tiene su propia URL de vista previa.
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Tarea diaria (05:00 UTC) que mantiene activo Supabase gratuito.
  "triggers": { "crons": ["0 5 * * *"] },
  "observability": { "enabled": true }
}
